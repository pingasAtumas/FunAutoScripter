# Claude Code settings (user-local, not project config)
.claude/

# Compiled LaTeX output
docs/*.pdf
docs/*.aux
docs/*.log
docs/*.toc
docs/*.out

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Optical flow cache files (large binary, regenerated automatically)
*.flowcache.npz

# Test/input video files
*.mp4
*.mkv
*.avi
*.mov
*.webm
*.m4v
*.ts
*.mpg
*.mpeg

# Generated funscript output
*.funscript

# Numpy truth arrays from tests
*.npy

# Debug outputs (root only — keep src/ and tests/ Python files)
/test.png
/cuts.png
/sinais.csv
/decisoes.json
/debug.png
/debug.roi.png

# Debug output directory
dbg/

# DearPyGui local dev install
.dpg/

# DearPyGui window layout (per-user, not shared)
/layout.ini

# Chapter definitions generated by detection (not hand-crafted)
*.chapters.json

# PyInstaller outputs
dist/
build/
# *.spec files (PyInstaller build config — committed to repo, not excluded)
# dist/ and build/ are excluded below instead

# Python virtual environments
.venv/
venv/

# Python packaging
*.egg-info/

# Nix build results
result
result-*
